# =============================================================================
# 9th INTER IIIT SPORTS MEET 2026 - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit credentials, database connection strings, or production keys.

# PostgreSQL Connection String (Neon, Supabase, or standard PostgreSQL)
# Example Neon string: postgresql://username:password@ep-cool-lake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inter_iiit

# Session Secret for signing/verifying HTTP-only session cookies
# Generate a random 32+ character string (e.g. openssl rand -base64 32)
SESSION_SECRET=super_secret_session_key_min_32_characters_long_inter_iiit_2026

# `npm run db:seed` creates unique random passwords in the ignored
# .private/seed-credentials.json file. Protect and distribute that file securely.

# Optional: Port configuration
PORT=3000

# Neon Object Storage private bucket for payment proofs
AWS_ENDPOINT_URL_S3=https://your-branch.storage.your-region.aws.neon.tech
AWS_ACCESS_KEY_ID=nak_live_...
AWS_SECRET_ACCESS_KEY=your-storage-credential-secret
AWS_REGION=ap-southeast-1
NEON_STORAGE_BUCKET=payment-proofs

# Official organizer UPI destination. Leave unset until verified by the sports cell.
# The student payment page shows a QR with the registration's exact amount when both are set.
# PAYMENT_UPI_ID=official-id@bank
# PAYMENT_PAYEE_NAME=Official Payee Name

# --- Security and sessions -------------------------------------------------
# Admin sessions last 60 days and IIIT sessions 30 days, extended while in use.
# ADMIN_SESSION_DAYS=60
# IIIT_SESSION_DAYS=30
# Session cookies are Secure in production. Set to false only when the site is
# served over plain HTTP (not recommended).
# COOKIE_SECURE=true
# Number of reverse proxies (e.g. nginx) in front of the app, used to read the
# client IP from X-Forwarded-For for rate limiting.
# TRUSTED_PROXY_HOPS=1

# Optional registration deadline (ISO 8601). After it, drafts cannot be saved
# or locked; payment for locked rosters is still accepted.
# REGISTRATION_CLOSES_AT=2026-12-05T23:59:59+05:30
